---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
// The Latin Inter of each weight the site uses, fetched with the page rather
// than once the stylesheet asks for them: otherwise each page shows first in
// the fallback face, then jumps as Inter arrives. The same files global.css
// names, so the URLs match.
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter500 from '@fontsource/inter/files/inter-latin-500-normal.woff2?url';
import inter600 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import inter700 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import LangSwitch from '../components/LangSwitch.astro';
import Profile from '../components/Profile.astro';
import { CLOUDFLARE_ANALYTICS_TOKEN } from '../data/analytics';
import { PROFILE } from '../data/profile';
import { locales, localizedPath, logicalPath, ogLocale, useTranslations, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** The page's own name; the home page has none. */
  title?: string;
  description: string;
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const t = useTranslations(locale);
const name = PROFILE.name[locale];
const fullTitle = title ? `${title} | ${name}` : name;
// With a slash, as GitHub Pages serves publications/index.html: the bare
// path only redirects there.
const path = logicalPath(Astro.url.pathname);
const absolute = (target: Locale) => new URL(localizedPath(target, path), Astro.site).href;
// The not-found page has no Japanese twin, so from there each language's
// switch goes to its home page.
const switchPath = noindex ? '/' : path;

const nav = [
  { path: '/', label: t.nav.home },
  { path: '/publications/', label: t.nav.publications },
  { path: '/talks/', label: t.nav.talks },
  { path: '/cv/', label: t.nav.cv },
];
---

{/* No animation: the new page simply takes the old one's place. */}
<html lang={locale} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {[inter400, inter500, inter600, inter700].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={absolute(locale)} />
        {/* The same page in the other language, for search engines. */}
        {locales.map((other) => <link rel="alternate" hreflang={other} href={absolute(other)} />)}
        <link rel="alternate" hreflang="x-default" href={absolute('en')} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(locale)} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {/* Links within the site swap the page's content in place of loading a
        new page: Safari draws a new page before its fonts are ready, so on
        every page change the text vanished for a moment. Scripts that set up
        a page run again on astro:page-load. */}
    <ClientRouter />
    {/* Counting visits, on the published site only. The page swaps above
        change the address without loading a page; the beacon counts each
        one as a visit to that page (spa). */}
    {import.meta.env.PROD && CLOUDFLARE_ANALYTICS_TOKEN && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CLOUDFLARE_ANALYTICS_TOKEN, spa: true })}
      ></script>
    )}
  </head>
  <body class="min-h-screen">
    <div class="h-1 bg-gradient-to-r print:hidden from-brand via-brand-soft to-accent"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-8 sm:px-6 print:block print:max-w-none print:p-0 md:grid md:grid-cols-[15rem_1fr] md:gap-12 md:py-14 lg:gap-16">
      {/* On a phone the tabs fill the row, so the switch sits up here beside the name. */}
      <div class="absolute top-8 right-4 sm:right-6 md:hidden print:hidden">
        <LangSwitch locale={locale} path={switchPath} compact />
      </div>
      {/* Kept as it is from page to page, so it is not drawn again; a new one
          comes with the other language. */}
      <aside class="md:sticky md:top-14 md:self-start print:static" transition:persist={`profile-${locale}`}>
        <Profile locale={locale} />
      </aside>

      <div class="mt-8 min-w-0 md:mt-0 print:mt-6">
        <nav class="flex items-end print:hidden justify-between gap-4 border-b border-line">
          <ul class="-mb-px flex gap-5 text-sm font-medium sm:gap-6">
            {nav.map((item) => (
              <li>
                <a
                  href={localizedPath(locale, item.path)}
                  class:list={[
                    'inline-block border-b-2 pb-3',
                    path === item.path ? 'border-brand text-brand' : 'border-transparent text-ink-muted hover:text-ink',
                  ]}
                  aria-current={path === item.path ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <div class="mb-2 hidden shrink-0 md:block">
            <LangSwitch locale={locale} path={switchPath} />
          </div>
        </nav>
        <main class="pt-8 print:pt-0">
          <slot />
        </main>
        <footer class="mt-16 print:hidden border-t border-line pt-6 text-xs text-ink-muted">
          © {new Date().getFullYear()} {PROFILE.name.en}
        </footer>
      </div>
    </div>
  </body>
</html>
