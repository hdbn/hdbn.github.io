---
// Taken from the DSCalgo lab site.
import { Icon } from 'astro-icon/components';
import 'katex/dist/katex.min.css';
import { abstractHtml } from '../lib/abstract';
import { TAGS } from '../data/tags';
import { publicationAnchor, titleHtml, venueWithYear, type Publication } from '../lib/bibtex';
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  publication: Publication;
}

const { locale, publication } = Astro.props;
const t = useTranslations(locale);

const badgeColor: Record<Publication['type'], string> = {
  journal: 'bg-brand text-white',
  proceedings: 'bg-brand-surface text-brand',
  preprint: 'bg-black/5 text-ink-muted',
  report: 'bg-black/5 text-ink-muted',
  thesis: 'bg-black/5 text-ink-muted',
  book: 'bg-black/5 text-ink-muted',
};

const linkIcons: { key: keyof Publication['links']; icon: string }[] = [
  { key: 'pdf', icon: 'lucide:file-text' },
  { key: 'code', icon: 'lucide:code' },
  { key: 'poster', icon: 'lucide:image' },
  { key: 'doi', icon: 'academicons:doi' },
  { key: 'arxiv', icon: 'academicons:arxiv' },
];

const bibtexId = `${publicationAnchor(publication.key)}-bibtex`;
const abstractId = `${publicationAnchor(publication.key)}-abstract`;
const venueText = venueWithYear(publication.venue, publication.year);
const journalVersionText = publication.journalVersion
  ? venueWithYear(publication.journalVersion.venue, publication.journalVersion.year)
  : undefined;
---

<li id={publicationAnchor(publication.key)} class="pub-item scroll-mt-16 border-b border-line py-3.5" data-pub-type={publication.type} data-award={publication.note ? "" : undefined} data-tags={publication.tags.join(' ')}>
  <h3 class="leading-snug font-semibold text-ink">
    <span class:list={['mr-1.5 inline-block rounded-full px-2 py-0.5 align-middle text-xs font-semibold', badgeColor[publication.type]]}>
      {t.publicationType[publication.type]}
    </span>
    <Fragment set:html={titleHtml(publication.title)} />
  </h3>
  <p class="mt-1 text-sm text-ink-muted">
    {publication.authors.map((author, i) => (
      <>
        {i > 0 && ', '}
        <span class:list={{ 'font-semibold text-ink': author.isMe }}>{author.name}</span>
      </>
    ))}
    {venueText && <span class="italic"> — {venueText}</span>}
  </p>
  {publication.summary && (
    <p class="mt-2 border-l-2 border-brand-soft pl-2.5 text-[0.95rem] leading-snug font-medium text-ink">{publication.summary[locale]}</p>
  )}
  {publication.note && (
    <p class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-accent">
      <Icon name="lucide:award" class="h-3.5 w-3.5" />
      {publication.note}
    </p>
  )}
  {publication.journalVersion && (
    <p class="mt-1 text-xs text-ink-muted">
      {t.publications.journalVersion}{' '}
      {publication.journalVersion.url ? (
        <a href={publication.journalVersion.url} class="text-brand hover:underline">
          {journalVersionText}
        </a>
      ) : (
        journalVersionText
      )}
    </p>
  )}
  <div class="mt-1.5 flex flex-wrap items-center gap-3">
    {/* The paper's topics first, then its links. */}
    {publication.tags.length > 0 && (
      <span class="flex flex-wrap gap-1">
        {publication.tags.map((tag) => (
          <span class="rounded bg-topic-surface px-1.5 py-px text-[0.7rem] font-medium text-topic">{TAGS[tag][locale]}</span>
        ))}
      </span>
    )}
    {linkIcons.map(({ key, icon }) => {
      const href = publication.links[key];
      if (!href) return null;
      return (
        <a href={href} class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline">
          <Icon name={icon} class="h-3.5 w-3.5" />
          {t.links[key]}
        </a>
      );
    })}
    {/* Each format the slides come in: a PDF opens, PowerPoint downloads. */}
    {publication.slides.map(({ url, format }) => (
      <a href={url} class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline" data-astro-reload>
        <Icon name="lucide:presentation" class="h-3.5 w-3.5" />
        {t.links.slides} ({format})
      </a>
    ))}
    {/* In the same row as the links; each opens under the row. */}
    {publication.abstract && (
      <button
        type="button"
        class="panel-toggle print:hidden inline-flex cursor-pointer items-center gap-1 text-xs font-medium text-brand hover:underline"
        aria-expanded="false"
        aria-controls={abstractId}
      >
        <Icon name="lucide:text" class="h-3.5 w-3.5" />
        {t.publications.abstract}
      </button>
    )}
    <button
      type="button"
      class="panel-toggle print:hidden inline-flex cursor-pointer items-center gap-1 text-xs font-medium text-brand hover:underline"
      aria-expanded="false"
      aria-controls={bibtexId}
    >
      <Icon name="lucide:quote" class="h-3.5 w-3.5" />
      {t.publications.bibtex}
    </button>
  </div>
  {publication.abstract && (
    // Abstracts are in English on both sides, as the papers are.
    <div id={abstractId} class="pub-abstract mt-2 rounded-lg bg-card p-3 text-sm leading-relaxed text-ink ring-1 ring-line" lang="en" hidden set:html={abstractHtml(publication.abstract)} />
  )}
  <pre id={bibtexId} class="mt-2 overflow-x-auto rounded-lg bg-black/[0.03] p-3 text-xs whitespace-pre text-ink-muted" hidden>{publication.rawBibtex}</pre>
</li>

<script>
  // On the document, which stays as pages are swapped in.
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('.panel-toggle');
    if (!button) return;
    const open = button.ariaExpanded !== 'true';
    button.ariaExpanded = String(open);
    document.getElementById(button.getAttribute('aria-controls') ?? '')!.hidden = !open;
  });
</script>
