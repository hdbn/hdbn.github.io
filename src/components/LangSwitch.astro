---
import { Icon } from 'astro-icon/components';
import { locales, localizedPath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** The page to switch to, in the other language. */
  path: string;
  /** Only the other language, for a phone's narrow row. */
  compact?: boolean;
}

const { locale, path, compact = false } = Astro.props;
const label = (other: Locale) => (other === 'en' ? 'EN' : '日本語');
const target = locales.find((other) => other !== locale)!;
---

{compact ? (
  <a
    href={localizedPath(target, path)}
    hreflang={target}
    lang={target}
    class="flex items-center gap-1 rounded-full bg-brand-surface px-3 py-1.5 text-xs font-semibold text-brand"
  >
    <Icon name="lucide:languages" class="h-3.5 w-3.5" />
    {label(target)}
  </a>
) : (

<ul class="flex items-center gap-1 rounded-full bg-brand-surface p-1 text-xs font-semibold">
  {locales.map((other) => (
    <li>
      <a
        href={localizedPath(other, path)}
        hreflang={other}
        lang={other}
        aria-current={other === locale ? 'page' : undefined}
        class:list={['block rounded-full px-2.5 py-1', other === locale ? 'bg-brand text-white' : 'text-brand']}
      >
        {label(other)}
      </a>
    </li>
  ))}
</ul>
)}
