---
import { Icon } from 'astro-icon/components';
import { talkSlides, type Talk } from '../data/talks';
import { PUBLICATIONS, publicationAnchor } from '../lib/bibtex';
import { formatMonth, localizedPath, useTranslations, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  talk: Talk;
}

const { locale, talk } = Astro.props;
const t = useTranslations(locale);
const slides = talkSlides(talk);
// A talk on a paper shows the paper's award, as the publication list does.
const award = talk.bibKey && PUBLICATIONS.find((pub) => pub.key === talk.bibKey)?.note;
---

<li class="flex flex-col gap-1 border-b border-line py-3 sm:flex-row sm:gap-4">
  <time datetime={talk.date} class="w-20 shrink-0 pt-0.5 text-sm text-ink-muted tabular-nums">{formatMonth(locale, talk.date)}</time>
  <div class="min-w-0">
    {/* Titles and events stay as given, in English, on both sides. */}
    <p class="leading-snug font-semibold text-ink" lang="en">
      {talk.title}
      {talk.kind && (
        <span class="ml-1.5 inline-block rounded-full bg-accent-surface px-2 py-0.5 align-middle text-xs font-semibold text-accent" lang={locale}>
          {t.talkKind[talk.kind]}
        </span>
      )}
    </p>
    <p class="mt-0.5 text-sm text-ink-muted" lang="en">
      {talk.eventUrl ? <a href={talk.eventUrl} class="underline decoration-ink-muted/30 underline-offset-2 hover:text-brand hover:decoration-brand">{talk.event}</a> : talk.event}
    </p>
    {award && (
      <p class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-accent" lang="en">
        <Icon name="lucide:award" class="h-3.5 w-3.5" />
        {award}
      </p>
    )}
    {(slides.length > 0 || talk.bibKey) && (
      <div class="mt-1 flex flex-wrap gap-3 text-xs font-medium">
        {slides.map(({ url, format }) => (
          <a href={url} class="inline-flex items-center gap-1 text-brand hover:underline">
            <Icon name="lucide:presentation" class="h-3.5 w-3.5" />
            {t.links.slides} ({format})
          </a>
        ))}
        {talk.bibKey && (
          <a
            href={`${localizedPath(locale, '/publications/')}#${publicationAnchor(talk.bibKey)}`}
            class="inline-flex items-center gap-1 text-brand hover:underline"
          >
            <Icon name="lucide:file-text" class="h-3.5 w-3.5" />
            {t.links.paper}
          </a>
        )}
      </div>
    )}
  </div>
</li>
