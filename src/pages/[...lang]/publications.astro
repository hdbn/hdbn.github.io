---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { PUBLICATIONS, groupByYear, type Publication } from '../../lib/bibtex';
import { TAGS, type Tag } from '../../data/tags';
import { localeStaticPaths, useTranslations, type Locale } from '../../lib/i18n';
import ts from 'typescript';
import listSource from '../../scripts/publication-list.ts?raw';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const grouped = groupByYear(PUBLICATIONS);

// The list is long, so a range of years is shown at a time, picked as a
// five-year period on a timeline, as on the DSCalgo lab site: 2025–2026,
// 2020–2024, … The address can name other years (#2007-2012), and these are
// shown too, marked on the timeline year by year. To begin with, the latest
// period.
const periods: { start: number; end: number; years: typeof grouped; count: number }[] = [];
for (const group of grouped) {
  const start = Math.floor(group.year / 5) * 5;
  let period = periods.at(-1);
  if (period?.start !== start) {
    period = { start, end: Math.min(start + 4, grouped[0].year), years: [], count: 0 };
    periods.push(period);
  }
  period.years.push(group);
  period.count += group.items.length;
}
// The axis starts at the first paper, not at a round year: the first period
// runs from it, so 1999 is a period of one year.
const first = periods.at(-1);
if (first) first.start = first.years.at(-1)!.year;
const firstYear = first!.start;
const lastYear = grouped[0].year;
// Each year's papers, gaps included, drawn as a bar over its period.
const yearCounts = new Map(grouped.map(({ year, items }) => [year, items.length]));
const rangeOf = ({ start, end }: { start: number; end: number }) => (start === end ? `${start}` : `${start}–${end}`);
const barYears = (start: number, end: number) => Array.from({ length: end - start + 1 }, (_, i) => start + i);
const barHeight = (n: number, max: number) => (n === 0 ? 0 : Math.max(8, (100 * n) / max));
const maxYearCount = Math.max(...yearCounts.values());
const latest = periods[0];
const inLatest = (year: number) => year >= latest.start;

// The list drawn as the address and the history entry have it, inline just
// after it so that it runs as the page is read: before the browser or the
// router puts the page back where the reader left it, which a module script
// would be too late for. See scripts/publication-list.ts.
const prepareInline = `(() => { const exports = {}; ${
  ts.transpileModule(listSource, {
    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, removeComments: true },
  }).outputText
} exports.prepare(document, location.hash, history.state); })();`;

// Peer-reviewed first, then the rest.
const typeOrder: Publication['type'][] = ['journal', 'proceedings', 'book', 'preprint', 'report', 'thesis'];
const types = typeOrder.filter((type) => PUBLICATIONS.some((p) => p.type === type));
// Topics in the order data/tags.ts gives them, those that some paper has.
const tags = (Object.keys(TAGS) as Tag[]).filter((tag) => PUBLICATIONS.some((p) => p.tags.includes(tag)));
---

<Base locale={locale} title={t.publications.heading} description={t.publications.description}>
  <h1 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">{t.publications.heading}</h1>

  <div class="publication-list mt-6" data-first-year={firstYear} data-last-year={lastYear}>
    <div class="mb-4 flex flex-wrap items-center gap-3 text-sm print:hidden">
      <label class="relative flex-1 basis-64">
        <span class="sr-only">{t.publications.searchLabel}</span>
        <input
          type="search"
          class="pub-search w-full rounded-full border border-line bg-card py-2 pr-4 pl-9 text-[16px] text-ink placeholder:text-ink-muted focus:border-brand focus:outline-none"
          placeholder={t.publications.searchPlaceholder}
          autocomplete="off"
        />
        <Icon name="lucide:search" class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-ink-muted" />
      </label>
      <span class="text-ink-muted">
        <span class="pub-count tabular-nums">{latest.count}</span>
        {locale === 'en' && ' '}<span class="pub-count-unit" data-one={t.publications.countOne} data-many={t.publications.countMany}>{t.publications.countMany}</span>
      </span>
    </div>

    <div class="mb-8 flex flex-wrap items-center gap-2 text-sm print:hidden">
      <button
        type="button"
        class="pub-award-chip inline-flex cursor-pointer items-center gap-1 rounded-full border border-line bg-card px-2.5 py-1 text-xs font-medium text-ink-muted aria-pressed:border-accent aria-pressed:bg-accent-surface aria-pressed:text-accent"
        aria-pressed="false"
      >
        <Icon name="lucide:award" class="h-3.5 w-3.5 text-accent" />
        {t.publications.awards}
      </button>
      <span class="mx-1 h-4 w-px bg-line" aria-hidden="true"></span>
      {types.map((type) => (
        <button
          type="button"
          class="pub-filter-chip cursor-pointer rounded-full border border-line bg-card px-2.5 py-1 text-xs font-medium text-ink-muted aria-pressed:border-brand aria-pressed:bg-brand-surface aria-pressed:text-brand"
          data-value={type}
          aria-pressed="false"
        >
          {t.publicationType[type]}
        </button>
      ))}
    </div>

    {tags.length > 0 && (
      <div class="-mt-5 mb-8 flex flex-wrap items-center gap-2 text-sm print:hidden">
        {tags.map((tag) => (
          <button
            type="button"
            class="pub-tag-chip cursor-pointer rounded border border-line bg-card px-2 py-0.5 text-xs font-medium text-ink-muted hover:border-topic hover:text-topic aria-pressed:border-topic aria-pressed:bg-topic-surface aria-pressed:text-topic"
            data-value={tag}
            aria-pressed="false"
          >
            {TAGS[tag][locale]}
          </button>
        ))}
      </div>
    )}

    {/* A time axis, oldest on the left, to scale, a year to a bar, cut into
        the five-year periods: a tick where each starts, and a bar for each
        year's papers, its year under it. A period is picked as a span of the
        axis; the bars of the years shown are dark, whether or not they are a
        period. The list itself runs newest first. */}
    <div class="pub-timeline mb-6 print:hidden" role="group" aria-label={t.publications.timeline}>
      <div class="mb-1 flex items-baseline justify-between gap-3 px-3 text-sm">
        <span class="pub-range-text font-semibold text-brand tabular-nums">{rangeOf(latest)}</span>
        <button type="button" class="pub-range-all cursor-pointer rounded-full border border-line bg-card px-2.5 py-0.5 text-xs font-medium text-ink-muted hover:border-brand hover:text-brand disabled:cursor-default disabled:opacity-40 disabled:hover:border-line disabled:hover:text-ink-muted">
          {t.publications.allYears}
        </button>
      </div>
      {/* A period of one year (1999, and the newest when a period has just
          begun) is given a little width, or its bar is a sliver on a phone. */}
      <div class="flex px-3">
        {[...periods].reverse().map(({ start, end, count }) => {
          const range = rangeOf({ start, end });
          return (
            <button
              type="button"
              aria-pressed={start === latest.start ? 'true' : 'false'}
              data-from={start}
              data-to={end}
              title={range}
              style={`flex: ${end - start + 1} 1 0; min-width: ${start === end ? '1.25rem' : '0'}`}
              class="pub-period-tab group relative flex min-w-0 cursor-pointer flex-col items-stretch rounded-t-lg pt-1 pb-1.5 tabular-nums hover:bg-brand-surface/40 disabled:cursor-default disabled:hover:bg-transparent aria-pressed:bg-brand-surface/60"
            >
              <span class="sr-only">{range}</span>
              <span class="pub-period-count text-center text-[0.7rem] text-ink-muted/80 group-disabled:opacity-40 group-aria-pressed:font-semibold group-aria-pressed:text-brand">{count}</span>
              <span class="flex h-12 items-end gap-[2px] px-[3px] group-disabled:opacity-40 sm:gap-1 sm:px-1" aria-hidden="true">
                {barYears(start, end).map((year) => (
                  <span
                    class="pub-year-bar flex-1 rounded-t-[3px] bg-ink-muted/25 transition-[height] group-hover:bg-brand-soft data-in:bg-brand"
                    data-year={year}
                    data-in={inLatest(year) ? '' : undefined}
                    style={`height: ${barHeight(yearCounts.get(year) ?? 0, maxYearCount)}%`}
                    title={`${year}: ${yearCounts.get(year) ?? 0}`}
                  />
                ))}
              </span>
              {/* The axis, thick and dark along the period picked; a tick at
                  the period's start, and at the very end of the axis. */}
              <span class="relative mt-1 h-2" aria-hidden="true">
                <span class="absolute inset-x-0 top-0 h-px bg-ink-muted/40 group-aria-pressed:h-1 group-aria-pressed:bg-brand" />
                <span class="absolute top-0 left-0 h-2 w-px bg-ink-muted/50" />
                {start === latest.start && <span class="absolute top-0 right-0 h-2 w-px bg-ink-muted/50" />}
              </span>
              {/* Under each bar its year, turned to read upwards, the year a
                  period starts darker than the rest. On a phone only the
                  years periods start are shown, so that they do not overlap. */}
              <span class="mt-0.5 flex gap-[2px] px-[3px] sm:gap-1 sm:px-1" aria-hidden="true">
                {barYears(start, end).map((year) => (
                  <span class="flex flex-1 justify-center">
                    <span
                      class:list={[
                        'rotate-180 text-[0.6rem] leading-none [writing-mode:vertical-rl] sm:text-[0.7rem]',
                        year === start ? 'font-semibold text-ink' : 'text-ink-muted/80 max-sm:invisible',
                        'group-aria-pressed:text-brand',
                      ]}
                    >
                      {year}
                    </span>
                  </span>
                ))}
              </span>
            </button>
          );
        })}
      </div>
    </div>

    <button type="button" class="pub-range-step mb-6 flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg border border-line bg-card px-3 py-1.5 text-sm text-ink-muted hover:border-brand hover:text-brand print:hidden" data-step="1" hidden>
      <Icon name="lucide:chevron-up" class="h-4 w-4 shrink-0" />
      <span>{t.publications.later}</span>
      <span class="pub-range-step-text font-semibold tabular-nums"></span>
    </button>

    <p class="pub-no-matches hidden text-ink-muted">
      <span class="pub-nowhere" hidden>{t.publications.noMatches}</span>
      <span class="pub-elsewhere">
        {t.publications.noneInRange}{' '}
        <button type="button" class="pub-range-all cursor-pointer text-brand hover:underline">
          {t.publications.allYears} (<span class="pub-elsewhere-count tabular-nums"></span>)
        </button>
      </span>
    </p>

    <div class="pub-years space-y-6">
      {grouped.map(({ year, items }) => (
        <section class="pub-year card" data-year={year} data-out={inLatest(year) ? undefined : ''}>
          {/* Stays at the top while its year scrolls by. */}
          <h2 class="sticky top-0 z-10 flex items-center gap-4 bg-card pt-1 pb-2 text-2xl font-bold tracking-tight text-brand tabular-nums after:h-px after:flex-1 after:bg-line print:static">{year}</h2>
          <ul>
            {items.map((publication) => <PublicationCard locale={locale} publication={publication} />)}
          </ul>
        </section>
      ))}
    </div>

    {/* The list runs newest first, so the earlier years are a step at its
        foot, the later ones a step at its head: as many years as are shown. */}
    <button type="button" class="pub-range-step mt-6 flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg border border-line bg-card px-3 py-1.5 text-sm text-ink-muted hover:border-brand hover:text-brand print:hidden" data-step="-1" data-from={periods[1]?.start} data-to={periods[1]?.end} hidden={!periods[1]}>
      <Icon name="lucide:chevron-down" class="h-4 w-4 shrink-0" />
      <span>{t.publications.earlier}</span>
      <span class="pub-range-step-text font-semibold tabular-nums">{periods[1] && rangeOf(periods[1])}</span>
    </button>
    <script is:inline set:html={prepareInline} />
  </div>
</Base>

<script>
  import { navigate } from 'astro:transitions/client';
  import {
    bounds,
    clampRange,
    hashTarget,
    rangeHash,
    readFilters,
    render,
    sameRange,
    show,
    type Filters,
    type Range,
  } from '../../scripts/publication-list';

  // Each time a page comes in (the site swaps pages in place, see Base.astro);
  // only the publication list has anything to set up. What it listens for on
  // the window is dropped when the next page comes in.
  //
  // The years shown are in the address, #2015-2020, so that picking them is a
  // step in the history, and Back goes to the years before, or to the paper a
  // link came to. The search and filters are kept in the history entry. The
  // list has already been drawn from both (scripts/publication-list.ts).
  let listeners: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    listeners?.abort();
    const list = document.querySelector<HTMLElement>('.publication-list');
    if (!list) return;
    listeners = new AbortController();
    const { signal } = listeners;
    const path = location.pathname;
    const timeline = list.querySelector<HTMLElement>('.pub-timeline')!;
    let shown: Range = show(list, location.hash, history.state);

    // Keeps the filters in this entry, and drops a paper's #pub-… from the
    // address once the reader has moved on from it.
    function filtersChanged() {
      const filters = readFilters(list!);
      render(list!, shown, filters);
      // An entry the browser made itself has no state, and is not the
      // router's to restore; one given state would confuse it.
      if (!history.state) return;
      const url = hashTarget(list!, location.hash) ? rangeHash(shown) : undefined;
      history.replaceState({ ...history.state, publications: filters }, '', url);
    }

    // Years picked are a step in the history: the router's, so that it keeps
    // the place on the page for it. The list follows only after the router
    // has kept the place in the entry left, as fewer years pull the page up.
    // However they are picked, the page stays where it is if the timeline is
    // still in sight, and else goes up to it, at the head of the new list
    // (from the step at the foot, or a long way down). The router records
    // the new entry as at the top until the reader scrolls, so it is told
    // where the page is.
    async function go(range: Range) {
      range = clampRange(list!, range);
      if (sameRange(range, shown) && location.hash === rangeHash(range)) return;
      const filters = readFilters(list!);
      await navigate(rangeHash(range), { state: { publications: filters } });
      shown = range;
      render(list!, range, filters);
      const { top, bottom } = timeline.getBoundingClientRect();
      if (top < 0 || bottom > innerHeight) timeline.scrollIntoView();
      if (history.state) history.replaceState({ ...history.state, scrollX, scrollY }, '');
    }

    for (const chip of list.querySelectorAll<HTMLButtonElement>('.pub-award-chip, .pub-filter-chip, .pub-tag-chip')) {
      chip.addEventListener('click', () => {
        chip.ariaPressed = chip.ariaPressed === 'true' ? 'false' : 'true';
        filtersChanged();
      });
    }
    list.querySelector<HTMLInputElement>('.pub-search')!.addEventListener('input', filtersChanged);

    for (const tab of list.querySelectorAll<HTMLButtonElement>('.pub-period-tab')) {
      tab.addEventListener('click', () => go({ from: Number(tab.dataset.from), to: Number(tab.dataset.to) }));
    }
    for (const all of list.querySelectorAll<HTMLButtonElement>('.pub-range-all')) {
      all.addEventListener('click', () => go(bounds(list!)));
    }
    // A step at the head or foot: the period next to the years shown.
    for (const step of list.querySelectorAll<HTMLButtonElement>('.pub-range-step')) {
      step.addEventListener('click', () => go({ from: Number(step.dataset.from), to: Number(step.dataset.to) }));
    }

    // Back and Forward within the page, or a hash typed in: the list as that
    // entry has it, drawn before the router scrolls to the entry's place
    // (this listens first, in the capture phase), and scrolled there again
    // in case it did not. With no state, it is the browser following a hash
    // the router left to it, and a paper's is gone to.
    addEventListener(
      'popstate',
      (event) => {
        if (location.pathname !== path || !list.isConnected) return;
        shown = show(list, location.hash, history.state);
        if (event.state === null) {
          hashTarget(list, location.hash)?.scrollIntoView();
        } else if (typeof history.state?.scrollY === 'number') {
          scrollTo({ left: history.state.scrollX ?? 0, top: history.state.scrollY, behavior: 'instant' });
        }
      },
      { capture: true, signal },
    );
  });
</script>

